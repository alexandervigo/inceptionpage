---
const steps = [
  {
    step: "01",
    title: "Nos contás",
    desc: "Reunión inicial 1:1 para entender tu operación, tus objetivos y el cuello de botella a resolver.",
    detail: "Diagnóstico y alcance"
  },
  {
    step: "02",
    title: "Diseñamos",
    desc: "Definimos la arquitectura, la interfaz y el flujo técnico con foco en claridad y conversión.",
    detail: "Dirección de arte y UX"
  },
  {
    step: "03",
    title: "Lanzamos",
    desc: "Publicamos tu web o sistema optimizado, verificado en móvil y listo para operar desde el día uno.",
    detail: "Código limpio y soporte"
  }
];
---

<div class="section-rule"></div>

<section id="proceso" class="relative py-24 lg:py-0 lg:min-h-[100svh] flex items-center overflow-hidden">
  <div class="inception-container w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Columna izquierda fija durante el locking -->
      <div class="lg:col-span-5" data-reveal>
        <p class="type-caption mb-4">Método de trabajo</p>
        <h2 class="type-h1 mb-5">
          ¿Cómo <span style="color: var(--accent);">trabajamos</span>?
        </h2>
        <p class="type-lead max-w-[42ch] mb-8">
          Tres etapas lineales que avanzan mientras bajás, sin fricción ni burocracia.
        </p>

        <!-- Barra de progreso vinculada al scroll -->
        <div class="hidden lg:block">
          <div class="flex items-center justify-between text-xs font-display uppercase tracking-[0.08em] text-[var(--text-muted)] mb-2">
            <span>Progreso</span>
            <span id="process-step-counter" style="color: var(--accent);">01 / 03</span>
          </div>
          <div class="w-full h-[2px] bg-[var(--border-subtle)] rounded-full overflow-hidden">
            <div
              id="process-progress-bar"
              class="h-full w-full origin-left scale-x-0 rounded-full"
              style="background: linear-gradient(90deg, var(--accent) 0%, var(--accent-cyan) 100%);"
            ></div>
          </div>
        </div>
      </div>

      <!-- Columna derecha: pasos que se iluminan progresivamente -->
      <div class="lg:col-span-7 relative pl-6 sm:pl-8 border-l border-[var(--border-subtle)] space-y-10">
        {steps.map((item, idx) => (
          <div
            data-process-step={idx}
            class="process-step relative transition-opacity duration-300"
          >
            <!-- Indicador circular sobre la línea -->
            <span
              data-process-dot
              aria-hidden="true"
              class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-3 h-3 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-base)] transition-colors duration-300"
            ></span>

            <div class="flex items-baseline justify-between gap-4 mb-2">
              <div class="flex items-baseline gap-4">
                <span data-process-num class="font-display text-2xl font-bold text-[var(--text-muted)] transition-colors duration-300">
                  {item.step}
                </span>
                <h3 class="type-h3">{item.title}</h3>
              </div>
              <span class="hidden sm:inline-block text-xs font-display uppercase tracking-[0.08em] text-[var(--text-muted)]">
                {item.detail}
              </span>
            </div>

            <p class="text-[var(--text-secondary)] max-w-[54ch] leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
