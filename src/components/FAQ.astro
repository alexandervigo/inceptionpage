---
import { faqs } from '../data/faqs.js';
---

<div class="section-rule"></div>

<section id="faqs" class="section-space relative">
  <div class="inception-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="type-caption mb-4">Preguntas frecuentes</p>
        <h2 class="type-h1 mb-5">
          Respuestas <span style="color: var(--accent);">directas</span>.
        </h2>
        <p class="type-lead max-w-[42ch]">
          Lo esencial sobre tiempos de entrega, inversión, propiedad del código y soporte técnico.
        </p>
      </div>

      <div class="lg:col-span-7 space-y-4" data-stagger-group>
        {faqs.map((item) => (
          <details class="sheen-card group p-6 sm:p-7" data-stagger-item>
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-display font-medium text-lg text-[var(--text-primary)]">
              <span>{item.q}</span>
              <span
                aria-hidden="true"
                class="w-8 h-8 shrink-0 rounded-full border border-[var(--border-subtle)] flex items-center justify-center text-[var(--accent)] transition-transform duration-300 group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-4 pt-4 border-t border-[var(--border-subtle)] text-[var(--text-secondary)] leading-relaxed max-w-[65ch]">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
