---
const services = [
  {
    index: "01",
    title: "Landing Pages",
    desc: "Sitios estratégicos diseñados para comunicar valor al instante y convertir visitas en consultas reales.",
    icon: "landing"
  },
  {
    index: "02",
    title: "Sistemas de Reservas",
    desc: "Agendas automatizadas e integraciones técnicas que ordenan tus turnos y atención las 24 horas.",
    icon: "booking"
  },
  {
    index: "03",
    title: "Plataformas Optimizadas",
    desc: "Webs y sistemas a medida con carga instantánea, código limpio y SEO técnico para retener usuarios.",
    icon: "speed"
  }
];
---

<div class="section-rule"></div>

<section id="servicios" class="section-space relative">
  <div class="inception-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-16" data-reveal>
      <div class="lg:col-span-7">
        <p class="type-caption mb-4">Nuestra especialidad</p>
        <h2 class="type-h1">
          Servicios <span style="color: var(--accent);">especializados</span>.
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="type-lead max-w-[44ch]">
          Infraestructura digital directa al objetivo comercial de cada operación.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-stagger-group>
      {services.map((service) => (
        <article class="sheen-card-intense p-8 sm:p-9 flex flex-col justify-between gap-8 group" data-stagger-item>
          <div class="flex items-center justify-between">
            <div
              class="w-12 h-12 rounded-xl border border-[var(--accent)]/35 bg-[var(--accent-soft)] flex items-center justify-center text-[var(--accent-cyan)] transition-transform duration-300 group-hover:scale-105"
              aria-hidden="true"
            >
              {service.icon === "landing" && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="3" />
                  <path d="M3 9h18" />
                  <path d="m14 14 4 4" />
                  <path d="m13 13 1.5 5 1.5-2 2-1.5-5-1.5Z" />
                </svg>
              )}
              {service.icon === "booking" && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="3" />
                  <path d="M16 2v4M8 2v4M3 10h18" />
                  <path d="m9 16 2 2 4-4" />
                </svg>
              )}
              {service.icon === "speed" && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 14l4-4" />
                  <path d="M3.34 19a10 10 0 1 1 17.32 0" />
                  <circle cx="12" cy="14" r="1.5" />
                </svg>
              )}
            </div>

            <span class="type-caption">{service.index}</span>
          </div>

          <div>
            <h3 class="type-h3 mb-3 group-hover:text-[var(--accent-cyan)] transition-colors">
              {service.title}
            </h3>
            <p class="text-[var(--text-secondary)] text-sm sm:text-base leading-relaxed">
              {service.desc}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
